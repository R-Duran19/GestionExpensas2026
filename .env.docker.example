# Configuración de la aplicación
APP_NAME="Gestión de Expensas - Las Palmeras"
APP_ENV=production
APP_KEY=base64:EdUUmyGLK68FBK3Mn3fBPxOMznnUThlztXHi9gOSLss=
APP_DEBUG=false
APP_URL=http://gestion-expensas.local

# Configuración de idioma
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_BO

# Configuración de base de datos para Docker
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=expensas_db
DB_USERNAME=expensas_user
DB_PASSWORD=secret_password

# Configuración adicional de MySQL (para docker-compose)
DB_ROOT_PASSWORD=root_secret_password
DB_PORT_HOST=3307

# Configuración de sesión
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Configuración de caché y colas
CACHE_STORE=database
QUEUE_CONNECTION=database

# Configuración de logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Configuración de correo (opcional)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@expensas.com"
MAIL_FROM_NAME="${APP_NAME}"

# Configuración de Vite
VITE_APP_NAME="${APP_NAME}"