# =============================================================================
# Plantilla de variables de entorno para docker-compose
# =============================================================================
# USO (en el VPS):
#   cp .env.example .env
#   nano .env   # <- rellenar con valores REALES
#
# Este archivo NO contiene secretos y SÍ se commitea.
# El archivo .env real con credenciales NUNCA se commitea (ver .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación Laravel
# -----------------------------------------------------------------------------
APP_NAME="Gestión de Expensas"
APP_ENV=production
APP_DEBUG=false
# Generar con:  php artisan key:generate --show
APP_KEY=base64:REEMPLAZAR_CON_APP_KEY_REAL
# [SEGURIDAD-09 / Fase 3.C] Key dedicada para HMAC de ci_hash.
# Generar con:  php artisan tinker --execute="echo 'base64:'.base64_encode(random_bytes(32));"
# Si no se setea, se usa APP_KEY como fallback.
PII_HASH_KEY=
APP_URL=https://expensas.acmanalytics.online
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_BO

# -----------------------------------------------------------------------------
# Base de datos (USAR CONTRASEÑAS FUERTES Y ÚNICAS EN PRODUCCIÓN)
# -----------------------------------------------------------------------------
DB_DATABASE=expensas_db
DB_USERNAME=expensas_app
DB_PASSWORD=CAMBIAR_POR_PASSWORD_FUERTE
DB_ROOT_PASSWORD=CAMBIAR_POR_ROOT_PASSWORD_FUERTE_DISTINTA

# -----------------------------------------------------------------------------
# Auto-deploy (migraciones + seeders al arrancar el contenedor)
# -----------------------------------------------------------------------------
RUN_MIGRATIONS=true
RUN_SEEDERS=true

# ----------------------------------------------------------------------------
# Pagos QR bancarios [PORTAL QR / Plan 12 Fase 4]
# Credenciales del merchant QR (Banco MC4 — mismas del sistema de tickets).
# driver: 'mc4' (producción) | 'fake' (simulador/tests)
# ----------------------------------------------------------------------------
BANCO_QR_DRIVER=mc4
BANCO_QR_API_URL=
BANCO_QR_API_KEY=
BANCO_QR_SERVICE_KEY=
BANCO_QR_USERNAME=
BANCO_QR_PASSWORD=
BANCO_QR_TIMEOUT=30
# URL pública que recibirá las notificaciones de pago (webhook del portal)
BANCO_QR_CALLBACK_URL=https://TU-DOMINIO/webhook/qr
# [REMEDIACIÓN-0.1] Secreto HMAC para autenticar las notificaciones del banco.
# El banco debe enviar el header X-Signature: HMAC-SHA256(body crudo, este secreto).
# SIN este valor el webhook RECHAZA todo (fail-closed). Generar con:
#   php -r "echo bin2hex(random_bytes(32));"
BANCO_QR_WEBHOOK_SECRET=
# Vencimiento del QR en horas (validar tope real del banco en pruebas)
BANCO_QR_VENCIMIENTO_HORAS=24
